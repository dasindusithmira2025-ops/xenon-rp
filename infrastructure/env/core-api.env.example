# Xenon Core API — internal authority for Link. Reachable only on the private network,
# unless Link runs in relay mode (LINK_GATEWAY_MODE=relay): then Link reaches Core over
# outbound HTTPS and Core also serves the relay (relay.pull / relay.complete) on the same
# signed /internal/v1 endpoint, backed by the same Redis. No extra variable is needed;
# a reverse proxy in front of Core must not buffer or cut responses held open ~30 s.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://xenon_core:...@db-host:5432/xenon?schema=public
REDIS_URL=redis://redis-host:6379
HASH_PEPPER=                 # same value as web/worker
NEXT_PUBLIC_SITE_URL=https://your-domain

LINK_CORE_SECRET=            # must equal link.env's value
CORE_API_HOST=127.0.0.1
CORE_API_PORT=3300
