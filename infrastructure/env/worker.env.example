# Xenon worker — job queue, outbox relay, status polling, sweeps.
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://xenon_worker:...@db-host:5432/xenon?schema=public
REDIS_URL=redis://redis-host:6379
HASH_PEPPER=                 # same value as web/core-api
NEXT_PUBLIC_SITE_URL=https://your-domain
DISCORD_GUILD_ID=

# Discord side effects go through Xenon Link; the worker has no bot token.
#   relay: requests are queued in Redis and Link pulls them through the Core API
#          (Link needs no listener). The worker and Core must share REDIS_URL.
#   http:  the worker POSTs to LINK_GATEWAY_URL. This is the default when unset.
LINK_GATEWAY_MODE=relay
# http mode only (required there, ignored in relay mode):
# LINK_GATEWAY_URL=http://link:8082
LINK_GATEWAY_SECRET=         # must equal link.env's value (both modes)

# Signs requests to the xenon_bridge resource on FXServer.
FIVEM_BRIDGE_SECRET=         # must equal the bridge's xenon_secret convar

WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8083
