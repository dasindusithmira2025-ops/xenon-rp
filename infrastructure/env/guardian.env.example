# Xenon Guardian — Discord security, moderation, onboarding, tickets, announcements.
# Holds ONLY Guardian's Discord credentials. No database, Redis, Core API,
# FiveM or Link secret belongs here.
NODE_ENV=production
LOG_LEVEL=info

# Discord Developer Portal -> "Xenon Guardian" application.
GUARDIAN_DISCORD_TOKEN=
GUARDIAN_DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Optional: website button on the ticket panel.
NEXT_PUBLIC_SITE_URL=

# Health endpoint (GET /healthz). Loopback by default; compose overrides as needed.
GUARDIAN_HEALTH_HOST=127.0.0.1
GUARDIAN_HEALTH_PORT=8081
