# Xenon website (Next.js). Unchanged by the two-bot split: the web tier never
# holds a bot token. Discord OAuth stays on the application it uses today, so
# existing logins and sessions are unaffected (see docs/TWO_BOT_MIGRATION.md).
NODE_ENV=production
LOG_LEVEL=info

DATABASE_URL=postgresql://xenon_web:...@db-host:5432/xenon?schema=public
REDIS_URL=redis://redis-host:6379

AUTH_SECRET=                 # openssl rand -base64 32
AUTH_DISCORD_ID=             # OAuth client id (current application; unchanged)
AUTH_DISCORD_SECRET=
AUTH_URL=https://your-domain
AUTH_TRUST_HOST=true

DISCORD_MODE=enabled
DISCORD_APPLICATION_ID=      # must equal AUTH_DISCORD_ID
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=https://discord.gg/your-invite

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.your-domain

TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

FIVEM_BRIDGE_SECRET=         # verifies /api/bridge/* requests from xenon_bridge
FIVEM_SERVER_URL=
# cfx-or-legacy (default) also admits licences proven by the retired in-game
# flow; switch to cfx-only once players have linked Cfx.re (docs/CFX_LINKING.md).
FIVEM_ADMISSION_MODE=cfx-or-legacy

# "Connect Cfx.re" (Discourse User API keys on forum.cfx.re). Callback:
# ${NEXT_PUBLIC_SITE_URL}/api/v1/me/cfx/callback
CFX_FORUM_URL=https://forum.cfx.re
CFX_APP_NAME=Xenon Roleplay

HASH_PEPPER=                 # same value as core-api/worker
NEXT_PUBLIC_SITE_URL=https://your-domain
AUTH_DEV_LOGIN=false
