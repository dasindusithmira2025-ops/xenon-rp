# Xenon Link — website / FiveM identity, whitelist, role sync, status.
# Holds Link's Discord credentials and the two service secrets. No database
# or Redis credential: Link reaches platform data only through the Core API.
NODE_ENV=production
LOG_LEVEL=info

# Discord Developer Portal -> "Xenon Link" application (NOT the Guardian app).
LINK_DISCORD_TOKEN=
LINK_DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
NEXT_PUBLIC_SITE_URL=https://your-domain

# Core API (Link -> Core). LINK_CORE_SECRET must equal core-api.env's value.
# In relay mode this must be the HTTPS URL Link can reach from outside.
CORE_API_URL=https://core.your-domain
LINK_CORE_SECRET=            # openssl rand -hex 32

# How worker requests reach Link.
#   relay: Link opens NO socket; it pulls worker requests from Core over outbound
#          HTTPS (single-instance / CyberNex hosting). Core and the worker must
#          share Redis.
#   http:  Link listens on LINK_GATEWAY_HOST:PORT and the worker POSTs to it
#          (docker compose / private network). This is the default when unset.
LINK_GATEWAY_MODE=relay
# Verifies worker-signed requests in both modes. Must equal worker.env's value.
LINK_GATEWAY_SECRET=         # openssl rand -hex 32  (different from LINK_CORE_SECRET)
# http mode only (ignored in relay mode):
# LINK_GATEWAY_HOST=127.0.0.1
# LINK_GATEWAY_PORT=8082

# Optional projection channels for integration events.
LINK_EVENTS_CHANNEL_ID=      # public: restarts, server up/down
LINK_STAFF_LOG_CHANNEL_ID=   # staff: whitelist decisions, links, sanctions, role-sync failures
