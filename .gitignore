# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
.next-e2e/
out/
*.tsbuildinfo
.turbo/

# env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# local tooling state
.kilo/
.claude/settings.local.json

# prisma local artifacts
packages/database/prisma/*.db
packages/database/generated/

# local scratch scripts (visual QA helpers, one-off checks)
*.local.mjs
*.local.ts

# tsc emit landing next to its sources. Everything in this repo builds into
# dist/, so a .js beside a .ts is always a leftover from a mis-run compiler -
# and one of those was committed once already.
apps/bot/src/**/*.js
apps/bot/src/**/*.js.map
fivem/*/src/**/*.js
