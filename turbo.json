{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PHASE",
    "CI",
    "LOG_LEVEL",
    "DATABASE_URL",
    "REDIS_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_TRUST_HOST",
    "AUTH_DEV_LOGIN",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET",
    "DISCORD_APPLICATION_ID",
    "DISCORD_GUILD_ID",
    "GUARDIAN_DISCORD_TOKEN",
    "GUARDIAN_DISCORD_APPLICATION_ID",
    "GUARDIAN_HEALTH_HOST",
    "GUARDIAN_HEALTH_PORT",
    "LINK_DISCORD_TOKEN",
    "LINK_DISCORD_APPLICATION_ID",
    "LINK_GATEWAY_HOST",
    "LINK_GATEWAY_PORT",
    "LINK_GATEWAY_URL",
    "LINK_GATEWAY_SECRET",
    "LINK_CORE_SECRET",
    "LINK_EVENTS_CHANNEL_ID",
    "LINK_STAFF_LOG_CHANNEL_ID",
    "CORE_API_URL",
    "CORE_API_HOST",
    "CORE_API_PORT",
    "WORKER_HEALTH_HOST",
    "WORKER_HEALTH_PORT",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY",
    "R2_SECRET_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "TURNSTILE_SECRET",
    "SENTRY_DSN",
    "HASH_PEPPER",
    "FIVEM_BRIDGE_SECRET",
    "FIVEM_SERVER_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "CFX_FORUM_URL",
    "CFX_APP_NAME",
    "FIVEM_ADMISSION_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
