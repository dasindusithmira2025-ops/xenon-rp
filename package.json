{
  "name": "xenonrp",
  "private": true,
  "version": "0.1.0",
  "description": "XenonRP \u00e2\u20ac\u201d the platform for the XENON ROLEPLAY community (web, Discord, FiveM).",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.17.0",
    "pnpm": ">=10.20.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @xenon/web test:e2e",
    "discord:diagnose": "node scripts/discord-config-diagnostic.mjs",
    "discord:register": "pnpm --filter @xenon/bot register",
    "discord:setup:plan": "pnpm --filter @xenon/bot setup plan",
    "discord:setup:apply": "pnpm --filter @xenon/bot setup apply",
    "discord:setup:status": "pnpm --filter @xenon/bot setup status",
    "discord:setup:repair": "pnpm --filter @xenon/bot setup repair",
    "discord:setup:validate": "pnpm --filter @xenon/bot setup validate",
    "discord:setup:cleanup": "pnpm --filter @xenon/bot setup cleanup",
    "discord:assets:scan": "pnpm --filter @xenon/bot assets scan",
    "discord:assets:import": "pnpm --filter @xenon/bot assets import",
    "discord:assets:generate": "pnpm --filter @xenon/bot assets generate",
    "discord:assets:sync": "pnpm --filter @xenon/bot assets sync",
    "rules:sync:plan": "pnpm --filter @xenon/web rules:sync:plan",
    "rules:sync:apply": "pnpm --filter @xenon/web rules:sync:apply",
    "rules:sync:verify": "pnpm --filter @xenon/web rules:sync:verify",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @xenon/database run generate",
    "db:migrate": "pnpm --filter @xenon/database run migrate",
    "db:deploy": "pnpm --filter @xenon/database run deploy",
    "db:studio": "pnpm --filter @xenon/database run studio",
    "db:seed": "pnpm --filter @xenon/database run seed",
    "db:seed:dev": "pnpm --filter @xenon/database run seed:dev",
    "db:reset": "pnpm --filter @xenon/database run reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@xenon/config": "workspace:*",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  }
}
