# =============================================================================
# XenonRP — environment configuration
#
# Copy to `.env` at the repo root: `cp .env.example .env`
# Values marked REQUIRED must be set before the stack will boot.
# Values marked REQUIRED IN PRODUCTION may stay empty for local development;
# the app falls back to a documented development driver and says so at startup.
# Never commit a filled-in .env.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores (REQUIRED) ---------------------------------------------------
# Matches docker-compose.yml. Change only if you run your own Postgres/Redis.
DATABASE_URL=postgresql://xenon:xenon@localhost:5442/xenon?schema=public
REDIS_URL=redis://localhost:6389

# --- Auth.js (REQUIRED) ------------------------------------------------------
# Generate with: openssl rand -base64 32     (or: npx auth secret)
AUTH_SECRET=
# Discord Developer Portal -> your application -> OAuth2 -> Client ID / Secret.
# Add redirect URI: http://localhost:3200/api/auth/callback/discord
# Port 3200, not 3000: dev machines commonly already have something on 3000,
# and the infrastructure ports below are offset for the same reason.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Only needed when running behind a proxy that rewrites the origin.
AUTH_URL=
AUTH_TRUST_HOST=false

# --- Discord (REQUIRED) ------------------------------------------------------
# Bot -> Token. Consumed only by apps/bot; the web tier never sees it.
DISCORD_BOT_TOKEN=
# General Information -> Application ID (same value as AUTH_DISCORD_ID).
DISCORD_APPLICATION_ID=
# Right-click your Discord server -> Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=
# NOTE: Discord role IDs are NOT configured here. They are stored in the
# database (DiscordRoleMapping) and managed from /control -> Integrations,
# so that changing a role mapping never requires a redeploy.

# --- Object storage: Cloudflare R2 (REQUIRED IN PRODUCTION) ------------------
# Without these, uploads use the local filesystem driver under .storage/.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Public base URL that fronts the bucket, e.g. https://cdn.example.com
R2_PUBLIC_URL=

# --- Cloudflare Turnstile (REQUIRED IN PRODUCTION) ---------------------------
# Without these, public abuse-sensitive forms skip the challenge in dev only.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- FiveM bridge (REQUIRED IN PRODUCTION) -----------------------------------
# Shared secret signing every request between Xenon and the xenon_bridge
# resource. Must be identical on both sides. Generate: openssl rand -hex 32
FIVEM_BRIDGE_SECRET=
# Base URL of the FXServer HTTP endpoint, e.g. http://127.0.0.1:30120
# Leave empty to run the mock game-server adapter.
FIVEM_SERVER_URL=

# --- Address hashing (REQUIRED IN PRODUCTION) --------------------------------
# Peppers the SHA-256 of client IP addresses recorded for abuse investigation.
# Without it, a stored hash of an IPv4 address is trivially reversible.
# Generate: openssl rand -hex 32
HASH_PEPPER=

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=

# --- Site (REQUIRED) ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# --- Local development only --------------------------------------------------
# Enables /api/dev/session, which signs in as a seeded fixture account without
# Discord. Refused outright when NODE_ENV=production; used by the E2E suite.
AUTH_DEV_LOGIN=false
