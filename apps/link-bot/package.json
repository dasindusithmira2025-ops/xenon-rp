{
  "name": "@xenon/link-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "register": "tsx src/scripts/register-commands.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@xenon/config": "workspace:*",
    "@xenon/contracts": "workspace:*",
    "@xenon/discord": "workspace:*",
    "@xenon/logger": "workspace:*",
    "discord.js": "14.27.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
