{
  "name": "@xenon/core-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./operations": "./src/operations.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@xenon/applications": "workspace:*",
    "@xenon/config": "workspace:*",
    "@xenon/contracts": "workspace:*",
    "@xenon/core": "workspace:*",
    "@xenon/database": "workspace:*",
    "@xenon/discord": "workspace:*",
    "@xenon/domain": "workspace:*",
    "@xenon/fivem": "workspace:*",
    "@xenon/jobs": "workspace:*",
    "@xenon/logger": "workspace:*",
    "@xenon/notifications": "workspace:*",
    "@xenon/permissions": "workspace:*",
    "@xenon/validation": "workspace:*",
    "bullmq": "6.3.8",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sanitize-html": "2.17.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
